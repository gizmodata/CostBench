# Copy to .env (gitignored) and fill in. provision.sh and teardown.sh source this.

# --- AWS auth: either an existing profile, or raw keys ---
# export AWS_PROFILE=my-profile
export AWS_ACCESS_KEY_ID=...
export AWS_SECRET_ACCESS_KEY=...
export AWS_REGION=us-east-1            # us-east-1 matches the pricing files in ../pricings

# --- Provisioning knobs (also accepted as plain env vars) ---
# export KEY_NAME=my-ec2-keypair      # optional: an existing key pair. If blank,
                                      #   provision.sh creates 'gizmosql-costbench-key'
                                      #   and saves the .pem here (gitignored).
# export SECURITY_GROUP_IDS=sg-xxxx   # optional: else an SSH-only SG is auto-created
# export INSTANCE_TYPE=i8ge.24xlarge  # default
# export ROOT_GB=100                   # root EBS gp3 size (GiB)
# export NAME=gizmosql-costbench       # instance Name tag (also used by teardown.sh)
# export SPOT=1                        # cheaper, but interruption wipes the run
